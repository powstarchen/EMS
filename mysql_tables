DROP TABLE IF EXISTS `DPM_real_data`;
CREATE TABLE `DPM_real_data` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `collection_time` timestamp(3) NOT NULL COMMENT '数据采集时间（精确到毫秒）',
  `device_id` int NOT NULL COMMENT 'Device ID from devices table',
  `device_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '电表名',
  `modbus_id` int NOT NULL COMMENT 'Modbus Unit ID（3-27）',
  `ip_address` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'success' COMMENT 'IP地址或url',
  `port` int NOT NULL COMMENT '端口号',
  `collection_status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'success' COMMENT '采集状态',
  `pt_ratio` int DEFAULT '1' COMMENT '电压ratio',
  `ct_ratio` int DEFAULT '1' COMMENT '电流ratio',
  `phase_loss_a` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'normal' COMMENT 'A相缺失',
  `phase_loss_b` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'normal' COMMENT 'B相缺失',
  `phase_loss_c` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'normal' COMMENT 'C相缺失',
  `current_direction_a` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'forward' COMMENT 'A相电流方向',
  `current_direction_b` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'forward' COMMENT 'B相电流方向',
  `current_direction_c` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'forward' COMMENT 'C相电流方向',
  `voltage_a` decimal(8,2) DEFAULT NULL COMMENT 'A相电压',
  `voltage_b` decimal(8,2) DEFAULT NULL COMMENT 'B相电压',
  `voltage_c` decimal(8,2) DEFAULT NULL COMMENT 'C相电压',
  `voltage_ab` decimal(8,2) DEFAULT NULL COMMENT 'AB线电压',
  `voltage_bc` decimal(8,2) DEFAULT NULL COMMENT 'BC线电压',
  `voltage_ca` decimal(8,2) DEFAULT NULL COMMENT 'CA线电压',
  `current_a` decimal(8,2) DEFAULT NULL COMMENT 'A相电流',
  `current_b` decimal(8,2) DEFAULT NULL COMMENT 'B相电流',
  `current_c` decimal(8,2) DEFAULT NULL COMMENT 'C相电流',
  `active_power_a` decimal(10,2) DEFAULT NULL COMMENT 'A相有功功率',
  `active_power_b` decimal(10,2) DEFAULT NULL COMMENT 'B相有功功率',
  `active_power_c` decimal(10,2) DEFAULT NULL COMMENT 'C相有功功率',
  `active_power_total` decimal(10,2) DEFAULT NULL COMMENT '总有功功率',
  `reactive_power_a` decimal(10,2) DEFAULT NULL COMMENT 'A相无功功率',
  `reactive_power_b` decimal(10,2) DEFAULT NULL COMMENT 'B相无功功率',
  `reactive_power_c` decimal(10,2) DEFAULT NULL COMMENT 'C相无功功率',
  `reactive_power_total` decimal(10,2) DEFAULT NULL COMMENT '总无功功率',
  `apparent_power_a` decimal(10,2) DEFAULT NULL COMMENT 'A相视在功率',
  `apparent_power_b` decimal(10,2) DEFAULT NULL COMMENT 'B相视在功率',
  `apparent_power_c` decimal(10,2) DEFAULT NULL COMMENT 'C相视在功率',
  `apparent_power_total` decimal(10,2) DEFAULT NULL COMMENT '总视在功率',
  `power_factor_a` decimal(5,2) DEFAULT NULL COMMENT 'A相功率因数',
  `power_factor_b` decimal(5,2) DEFAULT NULL COMMENT 'B相功率因数',
  `power_factor_c` decimal(5,2) DEFAULT NULL COMMENT 'C相功率因数',
  `power_factor_total` decimal(5,2) DEFAULT NULL COMMENT '总功率因数',
  `frequency` decimal(6,2) DEFAULT NULL COMMENT '频率（Hz）',
  `forward_active_energy` decimal(12,2) DEFAULT NULL COMMENT '正向有功电能',
  `reverse_active_energy` decimal(12,2) DEFAULT NULL COMMENT '反向有功电能',
  `forward_reactive_energy` decimal(12,2) DEFAULT NULL COMMENT '正向无功电能',
  `reverse_reactive_energy` decimal(12,2) DEFAULT NULL COMMENT '反向无功电能',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='DPM Real data table';

