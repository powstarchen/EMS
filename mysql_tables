DROP TABLE IF EXISTS `WM_real_data`;
CREATE TABLE `WM_real_data` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `collection_time` timestamp(3) NOT NULL COMMENT '数据采集时间（精确到毫秒）',
  `device_id` int NOT NULL COMMENT 'Device ID from devices table',
  `device_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '水表名',
  `modbus_id` int NOT NULL COMMENT 'Modbus Unit ID',
  `ip_address` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'success' COMMENT 'IP地址或url',
  `port` int NOT NULL COMMENT '端口号',
  `collection_status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT 'success' COMMENT '采集状态',
  `flow` decimal(10,2) DEFAULT NULL COMMENT '流速',
  `total_flow` decimal(10,2) DEFAULT NULL COMMENT '用水量',
  `pressure` decimal(10,2) DEFAULT NULL COMMENT '水压',
  `temperature` decimal(10,2) DEFAULT NULL COMMENT '水温',
  `battery` decimal(10,2) DEFAULT NULL COMMENT '电池电压',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='水表实时数据表';

