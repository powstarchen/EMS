  `return_temp` decimal(10,2) DEFAULT NULL COMMENT '回水温度',
  `delta_t` decimal(10,2) DEFAULT NULL COMMENT '温差',
  `power` decimal(10,2) DEFAULT NULL COMMENT '功耗',
  `energy` decimal(10,2) DEFAULT NULL COMMENT '总耗能',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='BTU实时数据表';

