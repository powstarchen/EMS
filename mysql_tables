  `di_5` tinyint DEFAULT '0' COMMENT '输入5',
  `di_6` tinyint DEFAULT '0' COMMENT '输入6',
  `di_7` tinyint DEFAULT '0' COMMENT '输入7',
  `di_8` tinyint DEFAULT '0' COMMENT '输入8',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='IO实时数据表（存储完整的IO读数）';

